# Required. Use long random values and do not commit the real .env file.
PINGLAKE_ADMIN_PASSWORD=replace-with-a-long-admin-password
PINGLAKE_ALLOW_WEAK_ADMIN_PASSWORD=false
PINGLAKE_ENROLLMENT_TOKEN=replace-with-a-long-random-enrollment-token

# Hub settings.
PINGLAKE_BIND=0.0.0.0:8090
PINGLAKE_DATABASE=/data/pinglake.db
PINGLAKE_COOKIE_SECURE=true
# Optional SMTP delivery. Recipients are configured in the console; keep the password in this file only.
PINGLAKE_SMTP_HOST=
PINGLAKE_SMTP_PORT=
PINGLAKE_SMTP_FROM=
PINGLAKE_SMTP_USERNAME=
PINGLAKE_SMTP_PASSWORD=
RUST_LOG=pinglake_hub=info,tower_http=info

# Required only when using deploy/docker-compose.tls.yml.
PINGLAKE_DOMAIN=

# Keep 127.0.0.1 when Caddy runs on the same host. For temporary IP-only
# testing, change this to 0.0.0.0 and set PINGLAKE_COOKIE_SECURE=false.
PINGLAKE_PUBLISH_ADDR=127.0.0.1
PINGLAKE_PUBLISH_PORT=8090

# Release identity and container resource bounds.
PINGLAKE_IMAGE_TAG=local
PINGLAKE_CPU_LIMIT=1.0
PINGLAKE_MEMORY_LIMIT=512m
PINGLAKE_PIDS_LIMIT=128
